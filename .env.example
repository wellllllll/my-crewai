# 复制此文件为 .env 并填入你的 API 密钥

# OpenAI API 密钥（必需）
# 如果使用火山方舟，请填入你的火山方舟 API Key
OPENAI_API_KEY=5298fa8b-7a86-4753-9726-853cc641de1e

# 自定义 API 端点（用于第三方兼容 OpenAI 的服务，如火山方舟）
# 火山方舟示例: https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/coding/v3

# 指定模型名称（必填，如果使用自定义 API）
# 火山方舟示例: doubao-pro-4k 或 doubao-pro-32k 等
OPENAI_MODEL_NAME=ark-code-latest

# Serper API 密钥（用于网络搜索，可选但推荐）
# 可以从 https://serper.dev/ 获取
SERPER_API_KEY=your_serper_api_key_here
